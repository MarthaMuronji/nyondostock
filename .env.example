# Copy to .env for local development. NEVER commit the real .env file.
# On Render, secret values are set in the dashboard (or generated by render.yaml), not here.

# Django secret key. On Render, render.yaml generates one for you.
SECRET_KEY=

# Set to True only for local development. Render defaults to False.
DEBUG=False

# Local dev: leave unset to use the bundled SQLite file (db.sqlite3).
# On Render: wired automatically to the managed Postgres via render.yaml.
DATABASE_URL=

# Optional: extra domains (comma-separated) if you add a custom domain on Render.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Provided automatically by Render on every deploy (the service's *.onrender.com host).
# You normally never set this yourself.
RENDER_EXTERNAL_HOSTNAME=
